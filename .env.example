# The service reads a bcrypt hash, never a plaintext password.
CMS_USERNAME=admin
CMS_PASSWORD_HASH_FILE=/etc/snappiestudio/cms-password.hash
SITE_ORIGINS=https://snappiestudio.com,https://www.snappiestudio.com
SITE_DIRECTORY=/var/www/snappie
PORT=3001
VISITOR_DB_PATH=/var/lib/snappiestudio-counter/visitors.sqlite
