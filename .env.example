# The service reads a bcrypt hash, never a plaintext password.
CMS_USERNAME=admin
CMS_PASSWORD_HASH_FILE=/etc/snappiestudio/cms-password.hash
SITE_ORIGINS=https://snappiestudio.com,https://www.snappiestudio.com
SITE_DIRECTORY=/var/www/snappie
PORT=3001
VISITOR_DB_PATH=/var/lib/snappiestudio-counter/visitors.sqlite
GEOIP_DB_PATH=/var/lib/snappiestudio-counter/geo/dbip-city-lite.mmdb

# Maintenance worker only; contains private account and database snapshots.
CMS_BACKUP_DIRECTORY=/var/lib/snappiestudio-backups

# Optional integrations: configure privately in /etc/snappiestudio/maintenance.env.
# Leave unset until the destination owner has configured access and recovery keys.
# CMS_OFFSITE_DESTINATION=backup@backup-host:/private/snappie
# CMS_OFFSITE_SSH_KEY=/home/ubuntu/.ssh/snappie_backup
# CMS_BACKUP_KEY_FILE=/etc/snappiestudio/backup-encryption.key
# CMS_ALERT_WEBHOOK=https://your-webhook-endpoint.example/notify
