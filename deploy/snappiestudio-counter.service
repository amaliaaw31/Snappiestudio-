[Unit]
Description=Snappie Studio anonymous visitor counter
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/project-yaya/Snappiestudio-
Environment=PORT=3001
Environment=VISITOR_DB_PATH=/var/lib/snappiestudio-counter/visitors.sqlite
Environment=GEOIP_DB_PATH=/var/lib/snappiestudio-counter/geo/dbip-city-lite.mmdb
Environment=SITE_DIRECTORY=/var/www/snappie
Environment=SITE_ORIGINS=https://snappiestudio.com,https://www.snappiestudio.com
EnvironmentFile=-/etc/snappiestudio/counter.env
ExecStart=/home/ubuntu/.nvm/versions/node/v24.21.0/bin/node /home/ubuntu/projects/project-yaya/Snappiestudio-/server/visitor-counter.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StateDirectory=snappiestudio-counter
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
