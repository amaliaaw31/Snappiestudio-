[Unit]
Description=Snappie daily backup and restore verification
After=snappiestudio-counter.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/project-yaya/Snappiestudio-
Environment=VISITOR_DB_PATH=/var/lib/snappiestudio-counter/visitors.sqlite
Environment=CMS_BACKUP_DIRECTORY=/var/lib/snappiestudio-backups
ExecStart=/home/ubuntu/.nvm/versions/node/v24.21.0/bin/node /home/ubuntu/projects/project-yaya/Snappiestudio-/scripts/maintenance.mjs backup
StateDirectory=snappiestudio-backups
StateDirectoryMode=0700
ReadWritePaths=/var/lib/snappiestudio-counter
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
